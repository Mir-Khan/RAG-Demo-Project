# Copy to .env and fill in the blanks. .env is gitignored; THIS file is committed —
# never put real secrets here.

# --- Database: Postgres 16 + pgvector ---
# Local Docker (docker-compose.yml):
#   postgresql://docqa:docqa@localhost:5432/docqa
# Or a managed free tier (e.g. Neon) — use the DIRECT (non-pooled) connection string:
DATABASE_URL=postgresql://docqa:docqa@localhost:5432/docqa

# --- Embeddings ---
# Sentence-Transformers model id. bge-small-en-v1.5 -> 384-dim vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# bge models were trained with an instruction prefix for the *query* side only.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Reranker (retrieval) ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- LLM. provider: gemini (default) | groq | ollama (local) | fake (tests) ---
LLM_PROVIDER=gemini
# Gemini key (default provider): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq key (alternative): https://console.groq.com
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# leave LLM_MODEL empty to use the provider default
#   gemini -> gemini-flash-lite-latest   groq -> llama-3.3-70b-versatile   ollama -> llama3.1
# NB: Gemini free tier is small (5 RPM / 20-1000 RPD by model). For the eval harness use
#     `python -m docqa.eval.run --provider ollama` instead of burning the quota.
LLM_MODEL=
LLM_TEMPERATURE=0.2
ANSWER_MAX_TOKENS=1500

# --- Orchestration ---
ROUTER_MIN_CONFIDENCE=0.45
MAX_CONTEXT_TOKENS=2800

# --- Active corpus: name of a file in config/corpora/<name>.yaml ---
CORPUS=fastapi
